# Gemfile for local development of the Jekyll site.
# Uses direct Jekyll dependencies so local development works on recent Ruby.

source "https://rubygems.org"

# Optional: pin a Ruby version you use locally (uncomment / change if desired)
# ruby "4.0.5"

# Jekyll runtime for local development
gem "jekyll", "~> 4.4"

# Needed for `bundle exec jekyll serve` on Ruby >= 3.0
group :development do
  gem "webrick", "~> 1.7"
  gem "jekyll-feed", "~> 0.17"
end